# ==============================================================================
# Agentic Voice SDR - Development Environment Variables Example
# NOTE: Replace placeholders locally. Never commit real credentials.
# ==============================================================================

# Redis Dev Configuration
REDIS_PORT=6379
REDIS_PASSWORD=replace_with_secure_dev_redis_password
REDIS_MAXMEMORY=256mb
REDIS_MAXMEMORY_POLICY=allkeys-lru

# RabbitMQ Dev Configuration
RABBITMQ_PORT=5672
RABBITMQ_MANAGEMENT_PORT=15672
RABBITMQ_DEFAULT_USER=replace_with_dev_rabbitmq_username
RABBITMQ_DEFAULT_PASS=replace_with_secure_dev_rabbitmq_password
RABBITMQ_DEFAULT_VHOST=/

# Gemini Live (local-only; never commit the real key)
GEMINI_API_KEY=replace_with_local_gemini_api_key
GEMINI_LIVE_MODEL=gemini-3.8-live
# Optional local fake-server endpoint for contract tests
# GEMINI_LIVE_ENDPOINT=ws://127.0.0.1:...
