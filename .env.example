# ==============================================================================
# Agentic Voice SDR - Development Environment Variables Example
# NOTE: Replace placeholders locally. Never commit real credentials.
# ==============================================================================

# Redis Dev Configuration (credentials supplied strictly via env/secret)
REDIS_PORT=6379
REDIS_PASSWORD=replace_with_secure_dev_redis_password
REDIS_MAXMEMORY=256mb
REDIS_MAXMEMORY_POLICY=allkeys-lru

# RabbitMQ Dev Configuration (credentials supplied strictly via env/secret)
RABBITMQ_PORT=5672
RABBITMQ_MANAGEMENT_PORT=15672
RABBITMQ_DEFAULT_USER=replace_with_dev_rabbitmq_username
RABBITMQ_DEFAULT_PASS=replace_with_secure_dev_rabbitmq_password
RABBITMQ_DEFAULT_VHOST=/

# PostgreSQL Dev Configuration (credentials supplied strictly via env/secret)
POSTGRES_PORT=5432
POSTGRES_DB=agentic_voice_sdr_dev
POSTGRES_USER=replace_with_dev_postgres_username
POSTGRES_PASSWORD=replace_with_secure_dev_postgres_password

# Supabase Dev Configuration (credentials supplied strictly via env/secret)
SUPABASE_URL=replace_with_dev_supabase_url
SUPABASE_ANON_KEY=replace_with_dev_supabase_anon_key
SUPABASE_SERVICE_ROLE_KEY=replace_with_dev_supabase_service_role_key

# Gemini Live (local-only; never commit the real key)
GEMINI_API_KEY=replace_with_local_gemini_api_key
GEMINI_LIVE_MODEL=gemini-3.8-live
# Optional local fake-server endpoint for contract tests
# GEMINI_LIVE_ENDPOINT=ws://127.0.0.1:...

# Owner-only outbound calls. Keep the token and destination allowlist empty
# until both are intentionally configured in the local runtime environment.
OWNER_API_TOKEN=
BARESIP_CTRL_TCP_ADDR=127.0.0.1:4444
HTTP_ADDR=127.0.0.1:8080
BARESIP_BINARY_PATH=/usr/bin/baresip
BARESIP_PROFILE_DIR=
BARESIP_MEDIA_MODULE_PATH=
BARESIP_SYSTEM_MODULE_DIR=/usr/lib/baresip/modules
OUTBOUND_CALL_DESTINATION_ALLOWLIST=
FALEPACO_AUDIOSOCKET_ENABLED=false
ASTERISK_PJSIP_CONFIG_DIR=
# ==============================================================================

# OpenRouter JEV semantic intent classification (local-only)
OPENROUTER_API_KEY=
OPENROUTER_JEV_MODEL=typesafe/jev-1.13
# Optional; defaults to the official OpenRouter API
OPENROUTER_BASE_URL=https://openrouter.ai/api

# Local PostgreSQL runtime connection (set PG* values only in .env)
PGHOST=127.0.0.1
PGPORT=5432
PGUSER=
PGPASSWORD=
PGDATABASE=agentic_voice_sdr_dev
