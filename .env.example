# ==============================================================================
# Agentic Voice SDR - Development Environment Variables Example
# Scope: Infrastructure Baseline (Redis, RabbitMQ, PostgreSQL & Supabase)
# NOTE: Replace placeholder values in your local .env file. Never commit real credentials.
# ==============================================================================

# Redis Dev Configuration (credentials supplied strictly via env/secret)
REDIS_PORT=6379
REDIS_PASSWORD=replace_with_secure_dev_redis_password
REDIS_MAXMEMORY=256mb
REDIS_MAXMEMORY_POLICY=allkeys-lru

# RabbitMQ Dev Configuration (credentials supplied strictly via env/secret)
RABBITMQ_PORT=5672
RABBITMQ_MANAGEMENT_PORT=15672
RABBITMQ_DEFAULT_USER=replace_with_dev_rabbitmq_username
RABBITMQ_DEFAULT_PASS=replace_with_secure_dev_rabbitmq_password
RABBITMQ_DEFAULT_VHOST=/

# PostgreSQL Dev Configuration (credentials supplied strictly via env/secret)
POSTGRES_PORT=5432
POSTGRES_DB=agentic_voice_sdr_dev
POSTGRES_USER=replace_with_dev_postgres_username
POSTGRES_PASSWORD=replace_with_secure_dev_postgres_password

# Supabase Dev Configuration (credentials supplied strictly via env/secret)
SUPABASE_URL=replace_with_dev_supabase_url
SUPABASE_ANON_KEY=replace_with_dev_supabase_anon_key
SUPABASE_SERVICE_ROLE_KEY=replace_with_dev_supabase_service_role_key
