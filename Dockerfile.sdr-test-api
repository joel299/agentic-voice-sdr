FROM golang:1.27-bookworm AS build
WORKDIR /src
COPY . .
RUN CGO_ENABLED=0 go build -o /out/sdr-test-api ./cmd/sdr-test-api
FROM debian:bookworm-slim
RUN apt-get update && apt-get install -y --no-install-recommends ca-certificates && rm -rf /var/lib/apt/lists/*
COPY --from=build /out/sdr-test-api /usr/local/bin/sdr-test-api
COPY cmd/sdr-test-api/openapi.test.yaml /app/openapi.test.yaml
COPY deploy/scalar-1.72.1.js /app/scalar.js
COPY deploy/scalar-1.72.1.css /app/scalar.css
EXPOSE 8081
ENTRYPOINT ["/usr/local/bin/sdr-test-api"]
